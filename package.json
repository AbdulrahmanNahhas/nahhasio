{
  "name": "nahhasio",
  "version": "0.1.0",
  "private": true,
  "description": "Private family media server, Linux viewing client, and transitional administration dashboard.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nahhasio/web dev",
    "build": "pnpm -r build && cargo build --workspace --locked",
    "typecheck": "pnpm --filter @arcadia/cli check:rust-editor && pnpm -r typecheck",
    "test": "pnpm -r test && cargo test --workspace --locked",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:rust",
    "format": "oxfmt --write .",
    "db:generate": "pnpm --filter @arcadia/database db:generate",
    "db:migrate": "pnpm --filter @arcadia/database db:migrate",
    "db:seed": "pnpm --filter @arcadia/database db:seed",
    "db:studio": "pnpm --filter @arcadia/database db:studio",
    "db:import": "pnpm --filter @arcadia/database db:import",
    "db:import:knowledge": "pnpm --filter @arcadia/database db:import:knowledge",
    "db:consolidate": "pnpm --filter @arcadia/database db:consolidate",
    "db:restore:legacy": "pnpm db:import:knowledge && pnpm db:consolidate",
    "client:generate": "pnpm --filter @nahhasio/api-contract generate",
    "arcadia": "pnpm --filter @arcadia/cli exec tsx src/main.ts",
    "test:e2e": "pnpm --filter @nahhasio/web test:e2e",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "dev:server": "PGUSER=\"${PGUSER:-$USER}\" cargo run --locked -p nahhasio-server",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format:check": "oxfmt --check .",
    "dev:reference-api": "pnpm --filter @arcadia/api dev",
    "nahhasio": "pnpm --filter @arcadia/cli exec tsx src/main.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@shadcn/lint": "0.2.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "^6",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@11.11.0"
}
