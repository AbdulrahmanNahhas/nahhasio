#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export NAHHASIO_SERVER_URL=http://127.0.0.1:23103/
export XDG_STATE_HOME="$project_root/data/development-local/demo/client-state"
export XDG_CACHE_HOME="$project_root/data/development-local/demo/client-cache"
export NAHHASIO_VIDEO_ROOT="$project_root/data/development-local/demo/videos"
if test "${1:-}" = --live; then
  export NAHHASIO_UI_URL=http://127.0.0.1:23110/
  cd "$project_root"
  cargo build --locked -p nahhasio-linux -j 2
  exec bash "$project_root/bin/nahhasio-native-runtime" "${CARGO_TARGET_DIR:-target}/debug/nahhasio-linux"
fi
unset NAHHASIO_UI_URL
exec bash "$project_root/bin/nahhasio-client" "$@"
