#!/usr/bin/env bash
# Direct entrypoint for the Nahhasio CLI.
#
# Bypasses `devenv shell`, whose enterShell banner writes to stdout and corrupts --json output.
# Only DATABASE_URL is required, so this works from any shell.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DATABASE_URL="${DATABASE_URL:-postgresql://127.0.0.1:23102/arcadia}"
exec node --import "$root/packages/cli/node_modules/tsx/dist/loader.mjs" "$root/packages/cli/src/main.ts" "$@"
