#!/usr/bin/env bash
# Quiet native operator tool. Build explicitly; never fall back to Node or choose a database.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
binary="${NAHHASIO_CLI_BIN:-$root/target/debug/nahhasio}"
if [[ ! -x "$binary" ]]; then
  echo 'Build the Rust CLI: devenv shell -- cargo build --locked -p nahhasio-cli' >&2
  exit 1
fi
exec "$binary" "$@"
