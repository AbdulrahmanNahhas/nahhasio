node_modules
.DS_Store
dist
dist-ssr
*.local
.env*
!.env.example
.tanstack
.wrangler
.output
.vinxi
test-results/
playwright-report/
__unconfig*
todos.json

# Native processes can leave large ELF core dumps in their working directory.
core.*

# typescript
*.tsbuildinfo

# Native workspace and build artifacts.
/target/
/.flatpak/
# Legacy Flatpak directories remain ignored until existing checkouts migrate.
/.flatpak-source/
/.flatpak-build/
/.flatpak-builder/
/.flatpak-user/
**/build/

# Local library state (created on first run)
data/*.db
data/*.db-*
data/media/*
data/backups/
data/previews/
data/ideas/
data/recovery/
data/development-packs/
data/development-local/

# Generated personalized catalog lists contain family watch history (directory or local symlink).
/catalog-lists

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# Claude Code local/session state — machine- and session-specific, never project config
.claude/settings.local.json
.claude/projects/

# Personal shell/editor/agent config that ends up in the working tree on this machine. None of it
# is project configuration, and some of it (shell rc files, MCP server definitions) can carry
# credentials — keep it out of the repo rather than relying on remembering not to `git add -A`.
/.aws/
/.codex/
.bashrc
.bash_profile
.zshrc
.zprofile
.profile
.gitconfig
.ripgreprc
.idea
.vscode
**/.mcp.json
.claude/agents
.claude/commands
.claude/hooks
.claude/output-styles
.claude/routines
.claude/workflows
.claude/skills
.claude/launch.json
.claude/loop.md
.claude/settings.json
apps/*/.claude/
apps/*/src/**/.claude/

# Local tooling scratch and caches.
/.tmp/
.ruff_cache/
__pycache__/
*.pyc

# Isolated browser production bundles must not race native package builds.
/apps/linux/ui/.playwright-build/
