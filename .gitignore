# Crash dumps: the Tauri shell and the API both drop ELF core files next to wherever they
# were launched, and they are large (hundreds of MB, sparse) — never something to commit.
core.*

# typescript
*.tsbuildinfo

# Native workspace and build artifacts.
/target/
**/build/

# Local library state (created on first run)
data/*.db
data/*.db-*
data/media/*
data/backups/
data/previews/
data/ideas/
data/recovery/
data/development-packs/
data/development-local/

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# Claude Code local/session state — machine- and session-specific, never project config
.claude/settings.local.json
.claude/projects/

# Personal shell/editor/agent config that ends up in the working tree on this machine. None of it
# is project configuration, and some of it (shell rc files, MCP server definitions) can carry
# credentials — keep it out of the repo rather than relying on remembering not to `git add -A`.
.bashrc
.bash_profile
.zshrc
.zprofile
.profile
.gitconfig
.ripgreprc
.idea
.vscode
**/.mcp.json
.claude/agents
.claude/commands
.claude/hooks
.claude/output-styles
.claude/routines
.claude/workflows
.claude/skills
.claude/launch.json
.claude/loop.md
.claude/settings.json
apps/*/.claude/
apps/*/src/**/.claude/
