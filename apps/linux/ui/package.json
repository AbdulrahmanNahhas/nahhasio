{
  "name": "@nahhasio/linux-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 23110 --strictPort",
    "build": "pnpm routes:generate && tsc --noEmit && vite build",
