    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lint": "6.9.8",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@nahhasio/api-contract": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@ui-sdk/core": "0.1.0-beta.18",
    "@ui-sdk/react": "0.1.0-beta.18",
    "@uiw/react-codemirror": "4.25.12",
    "class-variance-authority": "^0.7.1",
