    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
