# Optional local development overrides. The synthetic stack runs with an empty .env.
# Fill in credentials or uncomment overrides only for the workflows you use.
# Development and Cloud setup: docs/development/getting-started.md
# Installed server and provider configuration: docs/operations/runbook.md

# Server-owned credentials. Set these on the Rust server or in Podman config/server.env.
# Keep these values private. An API key enables subtitle search; both account fields enable downloads.
TMDB_API_READ_ACCESS_KEY=
FANART_API_KEY=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Standalone server or database operator. Select the database explicitly.
# The demo launchers supply their own database, bind address and storage.
# DATABASE_URL=postgresql://127.0.0.1:23102/nahhasio_development
# NAHHASIO_BIND=127.0.0.1:23103
# RUST_LOG=info
# NAHHASIO_CONFIG_ROOT=/absolute/path/to/private-server-config
# NAHHASIO_MEDIA_ROOT=/absolute/path/to/artwork/uploads
# NAHHASIO_PUBLIC_MEDIA_ROOT=/absolute/path/to/artwork

# Standalone native client. Keep video roots consistent with existing transfers.
# NAHHASIO_SERVER_URL=http://127.0.0.1:23103/
# NAHHASIO_VIDEO_ROOT=/absolute/path/to/videos
# Up to two Stremio-compatible torrent addons. Keep URLs and config private.
# NAHHASIO_TORRENT_ADDONS='[{"name":"My Addon","url":"https://addon.example.org","config":""}]'
