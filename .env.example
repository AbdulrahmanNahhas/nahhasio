# Copy to private .env; never commit real credentials or prefix secrets with VITE_.
# Server (startup never migrates or seeds).
NAHHASIO_BIND=127.0.0.1:23103
RUST_LOG=info
# DATABASE_URL=postgresql://user:password@127.0.0.1:23102/arcadia

# Server-owned provider credentials. Masked desktop administration is a future task.
TMDB_API_READ_ACCESS_KEY=
FANART_API_KEY=

# Server artwork, independent of client videos. Leave unset for development defaults
# data/media/uploads and data/media; use persistent absolute paths when deploying.
# NAHHASIO_MEDIA_ROOT=/absolute/path/to/media/uploads
# NAHHASIO_PUBLIC_MEDIA_ROOT=/absolute/path/to/media

# Native client. Video destination must match its existing durable transfer state.
# NAHHASIO_SERVER_URL=http://127.0.0.1:23103
# NAHHASIO_VIDEO_ROOT=/absolute/path/to/videos
# XDG_STATE_HOME=/absolute/path/to/state
NAHHASIO_TORRENTIO_URL=https://torrentio.strem.fun
NAHHASIO_TORRENTIO_CONFIG=qualityfilter=cam,480p

# Trusted local operator identity; explicit DATABASE_URL is required for database commands.
# NAHHASIO_CLI_ACTOR=admin-account-slug
# NAHHASIO_EDITOR_SECRET=<private random 32-byte hexadecimal value for CLI review tickets>

# Optional debug-only local administration; refused in release builds.
NAHHASIO_LOCAL_ADMIN=false
# NAHHASIO_LOCAL_ADMIN_TOKEN=<private random value of at least 32 characters>

# Recovery only: choose both sources explicitly. The artwork root contains /media/... paths.
# ARCADIA_V1_DB_PATH=/absolute/path/to/recovery.db
# ARCADIA_V1_ARTWORK_ROOT=/absolute/path/to/recovery-artwork
