# Nahhasio Rust foundation (loopback by default; does not migrate or seed)
NAHHASIO_BIND=127.0.0.1:23103
RUST_LOG=info

# Development only: explicit local dashboard administration. Refused in production/release.
NAHHASIO_LOCAL_ADMIN=false
# Generate a private random value with at least 32 characters; never prefix it with VITE_.
NAHHASIO_LOCAL_ADMIN_TOKEN=
NAHHASIO_API_URL=http://127.0.0.1:23103

# Copy this file to .env and fill in real values. .env is git-ignored; this file is not — keep
# placeholders here, never real secrets.

# TMDB (themoviedb.org) — free "API Read Access Token" under Settings > API. Used to search for
# and download poster/banner/logo artwork server-side (apps/api only, never sent to the client).
TMDB_API_KEY=
TMDB_API_READ_ACCESS_KEY=

# Fanart.tv — free personal API key from fanart.tv/webservice/register. Used as a supplemental
# source for high-quality transparent logo artwork.
FANART_API_KEY=

# Where uploaded/ingested poster, banner, and logo artwork lives on disk — outside the repo and
# outside apps/web, like a Jellyfin media directory. Defaults to repo-root data/media(/uploads),
# already git-ignored, if left unset; worth setting explicitly for a Docker volume mount, a
# NAS-mounted path, or just wherever you'd rather keep it on your own machine (e.g.
# ~/Pictures/Arcadia/uploads). ARCADIA_PUBLIC_MEDIA_ROOT only needs setting separately if it
# should differ from NAHHASIO_MEDIA_ROOT's parent (see apps/api/src/media-storage.ts).
NAHHASIO_MEDIA_ROOT=
ARCADIA_PUBLIC_MEDIA_ROOT=

NAHHASIO_STREAM_ADDON_URL=https://torrentio.strem.fun
NAHHASIO_STREAM_ADDON_CONFIG=qualityfilter=cam,480p
NAHHASIO_STREAM_TIMEOUT_MS= # Upstream timeout (default `8000`)
NAHHASIO_STREAM_CACHE_TTL_MS= # In-process response cache (default 15 min), so two family members opening the same film make one addon call.
NAHHASIO_STREAM_PREFERRED_HEIGHT= # Preferred vertical resolution (default `1080`). Ranking prefers the best release at or below this and treats anything larger as a last resort — a 4K remux will not reach first frame quickly on a family connection.
NAHHASIO_STREAM_ALLOW_TMDB_IDS=false # `true` lets `tmdb:` ids be sent when no IMDb id exists. Off by default until the addon is confirmed to accept them: a deployment that does not returns an empty list, which looks like "no sources" rather than "wrong id".

# OpenSubtitles REST v1 — free account key from opensubtitles.com/en/consumers (the newer
# key-based API, not the deprecated XML-RPC one). Used server-side (apps/api only) to search for
# and download subtitles for the future playback clients. Absent means the subtitle menu reports "no
# source configured" rather than failing obscurely — playback itself is unaffected either way.
OPENSUBTITLES_API_KEY=
# Optional; OpenSubtitles asks integrations to identify themselves. Defaults to "Arcadia v2" if
# left unset.
OPENSUBTITLES_USER_AGENT=

# Preferred Nahhasio artwork/audit names; legacy ARCADIA names remain supported.
# NAHHASIO_MEDIA_ROOT=/absolute/path/to/uploads
# NAHHASIO_PUBLIC_MEDIA_ROOT=/absolute/path/to/media
# NAHHASIO_CLI_ACTOR=admin-account-slug
