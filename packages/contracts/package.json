{
  "name": "@arcadia/contracts",
  "version": "2.0.0",
  "private": true,
  "description": "Shared catalog and administrative validation contracts.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./work": "./src/work-document.ts",
    "./editor": "./src/editor-model.ts",
    "./projection": "./src/editor-projection.ts",
    "./editor-rpc": "./src/editor-rpc.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate:rust-editor": "tsx scripts/generate-rust.ts",
    "check:rust-editor": "tsx scripts/generate-rust.ts --check",
    "generate:editor-api": "tsx scripts/generate-api.ts"
  },
  "dependencies": {
    "@arcadia/domain": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
