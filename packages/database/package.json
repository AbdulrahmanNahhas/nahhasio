{
  "name": "@arcadia/database",
  "version": "2.0.0",
  "private": true,
  "description": "PostgreSQL schema, current-catalog baseline, additive migrations and explicit recovery tooling.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "schema:graph": "tsx src/export-schema-graph.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:import": "tsx src/import-v1.ts",
    "db:import:knowledge": "tsx src/import-v1-knowledge.ts",
    "db:consolidate": "tsx src/consolidate-v1-franchises.ts",
    "db:repair:scores": "tsx src/repair-v1-duplicate-scores.ts",
    "db:prepare-legacy-media": "tsx src/prepare-media-backfill.ts"
  },
  "dependencies": {
    "@arcadia/domain": "workspace:*",
    "better-auth": "^1.7.28",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
