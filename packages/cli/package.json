{
  "name": "@arcadia/cli",
  "version": "2.0.0",
  "private": true,
  "description": "Agent tools for the Nahhasio PostgreSQL catalog.",
  "bin": {
    "arcadia": "./src/main.ts",
    "nahhasio": "./src/main.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/main.ts",
    "./work": "./src/commands/work.ts",
    "./db": "./src/db.ts",
    "./editor": "./src/editor/service.ts"
  },
  "scripts": {
    "arcadia": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "nahhasio": "tsx src/main.ts"
  },
  "dependencies": {
    "@arcadia/api": "workspace:*",
    "@arcadia/contracts": "workspace:*",
    "@arcadia/domain": "workspace:*",
    "postgres": "^3.4.7",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nahhasio/api-contract": "workspace:*",
    "@types/node": "^22",
    "typescript": "^6",
    "vitest": "^4.0.18"
  }
}
