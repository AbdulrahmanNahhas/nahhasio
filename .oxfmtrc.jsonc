{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".tmp/**",
    "tools/oxlint/anti-slop/**",
    "apps/linux/ui/src/components/ui/**",
    "packages/database/drizzle/**",
    "docs/archive/**",
    "migration-report.json",
    "pnpm-lock.yaml",
    "skills-lock.json",
    "target/**",
    "apps/linux/ui/src/routeTree.gen.ts",
  ],
  "sortImports": true,
}
